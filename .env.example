# Copy to .env and fill in real values. NEVER commit .env.

# --- App ---
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database ---
# For PostgreSQL (via docker compose up):
# DATABASE_URL=postgresql+psycopg://dda:dda@localhost:5432/dda
# For local SQLite development (portable across all clone paths):
DATABASE_URL=sqlite:///backend/dda.db

# --- LLM provider chain (Step 7) ---
# First provider that succeeds wins; later entries are fallbacks on rate-limit/error.
LLM_PROVIDER_CHAIN=groq,openrouter

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Rate Limiting (SlowAPI) ---
RATE_LIMIT_PREDICT=30/minute
RATE_LIMIT_REASON=10/minute
RATE_LIMIT_NOTE_EXTRACT=15/minute
