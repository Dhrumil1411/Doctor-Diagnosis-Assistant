# Copy to .env and fill in real values. NEVER commit .env.

# --- App ---
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database (Postgres via docker-compose, Step 3) ---
DATABASE_URL=postgresql+psycopg://dda:dda@localhost:5432/dda

# --- LLM provider chain (Step 7) ---
# First provider that succeeds wins; later entries are fallbacks on rate-limit/error.
LLM_PROVIDER_CHAIN=groq,openrouter

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
